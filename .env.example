# 运行模式：mock（本地剧本，无需凭据）| coze（真实工作流）
COZE_MODE=mock

# 鉴权方式：jwt（推荐，免 PAT）| pat
COZE_AUTH=jwt

# JWT 方式：指向 cozepy 生成的 coze_oauth_config.json。
# 私钥不进本仓库，只存路径；BFF 运行时读取并换取短期 token（自动续期）。
COZE_JWT_CONFIG=

# PAT 方式（COZE_AUTH=pat 时才用）。只放服务端，绝不能进前端 bundle / Git
COZE_PAT=

COZE_BOT_ID=
COZE_API_BASE=https://api.coze.cn

# 联调阶段打草稿版本；上线改 published_online
COZE_PUBLISH_STATUS=unpublished_draft

# start 节点参数。159331（清空会话历史）按这个名字找会话，改它会清错会话
COZE_CONVERSATION_NAME=Default

# 服务端口
PORT=8787
HOST=127.0.0.1

# P0-1 的临时方案：只允许一个活跃课堂。默认关闭，演示/多人验收时不要开
ENFORCE_SINGLE_CLASS=0
